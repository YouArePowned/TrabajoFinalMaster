# ============================================================
# LocalMind-AI — Environment Configuration
# ============================================================
# Copy this file to .env and edit as needed:
#   cp .env.example .env
# ============================================================

# --- Ollama Configuration ---
# Set to "true" to run Ollama inside Docker, "false" to use an external instance
OLLAMA_DOCKER=true

# URL where nanobot will reach Ollama.
#   - If OLLAMA_DOCKER=true  → use http://ollama:11434 (Docker internal DNS)
#   - If OLLAMA_DOCKER=false → set your external URL, e.g. http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434

# Model to use (must be available in your Ollama instance)
OLLAMA_MODEL=qwen3:4b

# --- Nanobot Agent ---
# Context window size (tokens). Keep low for limited hardware.
CONTEXT_WINDOW_TOKENS=8192

# Max tool iterations per turn
MAX_TOOL_ITERATIONS=25

# Temperature for generation (0.0 - 2.0)
TEMPERATURE=0.7

# --- Resource Limits ---
# Memory limits for Docker containers
OLLAMA_MEMORY_LIMIT=8G
NANOBOT_MEMORY_LIMIT=4G